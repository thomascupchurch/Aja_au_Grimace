 import os, sys, json, datetime
+from typing import Optional, Tuple
+
+def build_printer(
+    *,
+    page_size: Optional[str] = None,
+    orientation: Optional[str] = None,
+    margins_mm: Optional[Tuple[float, float, float, float]] = None,
+    output_path: Optional[str] = None,
+    output_format: str = 'PDF'
+):
+    """Construct a QPrinter with PyQt6-friendly enums and fallbacks.
+
+    Args:
+      page_size: 'A4' | 'Letter' | 'Legal' | 'Tabloid' | None
+      orientation: 'Portrait' | 'Landscape' | None
+      margins_mm: (left, top, right, bottom) in millimeters
+      output_path: when provided, set as output file name
+      output_format: 'PDF' currently supported
+
+    Returns:
+      QPrinter instance (or raises RuntimeError if QtPrintSupport missing)
+    """
+    try:
+        from PyQt6.QtPrintSupport import QPrinter
+    except Exception as e:  # pragma: no cover
+        raise RuntimeError('QPrinter not available') from e
+
+    # Mode
+    try:
+        mode = QPrinter.PrinterMode.HighResolution
+    except Exception:
+        mode = getattr(QPrinter, 'HighResolution', getattr(QPrinter, 'PrinterResolution', None))
+    printer = QPrinter(mode) if mode is not None else QPrinter()
+
+    # Output format
+    if (output_format or '').upper() == 'PDF':
+        try:
+            pdf_fmt = QPrinter.OutputFormat.PdfFormat
+        except Exception:
+            pdf_fmt = getattr(QPrinter, 'PdfFormat', None)
+        try:
+            if pdf_fmt is not None:
+                printer.setOutputFormat(pdf_fmt)
+        except Exception:
+            pass
+
+    # Page size
+    if page_size:
+        try:
+            size_map = {
+                'A4': QPrinter.PageSize.A4,
+                'LETTER': QPrinter.PageSize.Letter,
+                'LEGAL': QPrinter.PageSize.Legal,
+                'TABLOID': QPrinter.PageSize.Tabloid,
+            }
+        except Exception:
+            size_map = {
+                'A4': getattr(QPrinter, 'A4', None),
+                'LETTER': getattr(QPrinter, 'Letter', None),
+                'LEGAL': getattr(QPrinter, 'Legal', None),
+                'TABLOID': getattr(QPrinter, 'Tabloid', None),
+            }
+        try:
+            psize = size_map.get(str(page_size).upper()) or size_map.get('A4')
+            if psize is not None:
+                # setPageSize for PyQt6; fallback to setPaperSize for PyQt5
+                try:
+                    printer.setPageSize(psize)  # type: ignore[arg-type]
+                except Exception:
+                    printer.setPaperSize(psize)  # type: ignore[arg-type]
+        except Exception:
+            pass
+
+    # Orientation
+    if orientation:
+        try:
+            portrait = QPrinter.Orientation.Portrait
+            landscape = QPrinter.Orientation.Landscape
+        except Exception:
+            portrait = getattr(QPrinter, 'Portrait', None)
+            landscape = getattr(QPrinter, 'Landscape', None)
+        try:
+            ori = str(orientation).upper()
+            if ori == 'LANDSCAPE' and landscape is not None:
+                printer.setOrientation(landscape)
+            elif portrait is not None:
+                printer.setOrientation(portrait)
+        except Exception:
+            pass
+
+    # Margins
+    if margins_mm:
+        try:
+            from PyQt6.QtCore import QMarginsF
+            try:
+                # Prefer specifying units explicitly to avoid DPI/points confusion
+                from PyQt6.QtGui import QPageLayout
+                unit_mm = QPageLayout.Unit.Millimeter
+            except Exception:
+                unit_mm = None
+            l, t, r, b = margins_mm
+            marginsf = QMarginsF(float(l), float(t), float(r), float(b))
+            if unit_mm is not None:
+                try:
+                    printer.setPageMargins(marginsf, unit_mm)
+                except Exception:
+                    printer.setPageMargins(marginsf)
+            else:
+                printer.setPageMargins(marginsf)
+        except Exception:
+            pass
+
+    # Output path
+    if output_path:
+        try:
+            printer.setOutputFileName(output_path)
+        except Exception:
+            pass
+
+    return printer
 
 def resolve_resource_path(path: str) -> str:
     if not path: return path
