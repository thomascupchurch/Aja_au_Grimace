# Vols Signage App - SQL Server Configuration Example

# Rename this file to `config.env` and edit the values below.
# You can double-click this file to open in Notepad, or edit with any text editor.
#
# To use: run the app with this file in the same folder as Vols Signage.exe, or set these variables in your environment.

# SQL Server connection string for SQLAlchemy/pyodbc
WEB_DB_URL=mssql+pyodbc://username:password@server_address:1433/database_name?driver=ODBC+Driver+17+for+SQL+Server

# Example:
# WEB_DB_URL=mssql+pyodbc://sa:yourpassword@192.168.1.100:1433/ProjectDB?driver=ODBC+Driver+17+for+SQL+Server

# Optional: restrict editing to users with this token
# WEB_EDIT_TOKEN=your-strong-shared-secret

# Optional: set path to images folder
# WEB_IMAGES_ROOT=C:/path/to/images

# Optional: watermark text for the app footer
# WEB_WATERMARK_TEXT=For internal use only

# Save and close this file. The app will read these settings automatically if present.
